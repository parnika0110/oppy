{
  "name": "oppy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "discovery:run": "node --env-file=.env.local --import tsx scripts/discovery-run.ts",
    "discovery:probe-devpost": "node --import tsx scripts/probe-devpost.ts",
