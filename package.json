    "cheerio": "^1.2.0",
    "date-fns": "^4.1.0",
    "mammoth": "^1.12.2",
    "mongodb": "^6.12.0",
    "next": "15.1.4",
    "openai": "^4.77.0",
    "pdf-parse": "^2.4.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "rss-parser": "^3.13.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "esbuild": "~0.28.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.1.4",
    "postcss": "^8.4.49",
