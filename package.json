    "lifecycle:refresh": "node --env-file=.env.local --import tsx scripts/refresh-lifecycle.ts",
    "seed": "tsx scripts/seed.ts",
    "data:clear-static-deadlines": "node --env-file=.env.local --import tsx scripts/clear-static-deadlines.ts",
    "data:apply-static-deadline-clear": "node --env-file=.env.local --import tsx scripts/clear-static-deadlines.ts --apply",
    "images:audit": "node scripts/image-audit.js",
    "images:backfill": "node --env-file=.env.local --import tsx scripts/image-backfill.ts",
    "hn:reprocess": "node --env-file=.env.local --import tsx scripts/hn-reprocess-tags.ts",
