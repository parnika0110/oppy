# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/oppy?retryWrites=true&w=majority
MONGODB_URI=

# Database name (kept separate so you can point at a different DB per environment)
MONGODB_DB=oppy

# OpenAI API key — used ONLY server-side, ONLY at ingestion time
OPENAI_API_KEY=

# Shared secret required to call the admin ingestion endpoint.
# No user auth in MVP — this is a simple bearer-token gate, generate any long random string.
ADMIN_SECRET=

# Secret used by Vercel Cron. It must be set in production; cron requests fail closed without it.
CRON_SECRET=

# Base URL of the deployed app (used for metadata/OG tags)
NEXT_PUBLIC_APP_URL=http://localhost:3000
