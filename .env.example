# ── Core (REQUIRED) ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Sarvam AI (OPTIONAL) ────────────────────────────────────────────────
# Get from https://sarvam.ai → API Keys
# Enables: natural language query interpretation, voice search, translation
SARVAM_API_KEY=                    # SERVER ONLY

# ── Gnani AI voice (OPTIONAL) ───────────────────────────────────────────
# Enables /voice — Gnani Prisma speech-to-text (POST /api/stt) and Gnani
# Timbre text-to-speech (POST /api/tts). Without a key the voice page still
# works: typed search, demo transcripts (GNANI_MOCK=true) and the browser's
# built-in speech voice for spoken replies.
GNANI_API_KEY=                     # SERVER ONLY — never exposed to the browser
# GNANI_API_BASE_URL=https://api.vachana.ai
# GNANI_MOCK=true                   # SERVER ONLY — demo mode: zero Gnani API calls
# GNANI_PRISMA_STT_PATH=/stt/v3
# GNANI_PRISMA_FORMAT=transcribe
# GNANI_PRISMA_DEFAULT_LANGUAGE=en-IN
# GNANI_TIMBRE_TTS_PATH=/api/v1/tts/inference
# GNANI_TIMBRE_MODEL=timbre-v2.5
# GNANI_TIMBRE_VOICE=Nalini
# GNANI_TIMEOUT_MS=25000

# ── Admin (REQUIRED) ────────────────────────────────────────────────────
ADMIN_SECRET=                      # SERVER ONLY — shared secret for admin API access
CRON_SECRET=                       # SERVER ONLY — secret for scheduled ingestion

# ── Discovery Sources ──────────────────────────────────────────────────
# RapidAPI key — enables JSearch (aggregates LinkedIn, Indeed, Glassdoor,
# Naukri, ZipRecruiter). Also powers dedicated LinkedIn, Indeed, Glassdoor,
# and Wellfound adapters.
RAPIDAPI_KEY=                      # SERVER ONLY

# Luma calendar slugs (comma-separated) — e.g. "buildclub,frontier-tower"
LUMA_CALENDARS=                    # SERVER ONLY

# ── Sources that work without any API key ──────────────────────────────
# Devpost hackathons     — public JSON API, no auth
# Devfolio + MLH         — public HTML scraping, no auth
# Naukri                 — public HTML scraping, no auth
# Internshala            — public HTML scraping, no auth (8 categories)
# RemoteOK               — public JSON API, no auth
# YC Work at a Startup   — public API, no auth
# Hacker News Who's Hiring — public HN Algolia API, no auth
# Eventbrite             — public HTML scraping, no auth
# Unstop (D2C)           — public API, no auth
# RSS Feeds              — 15+ public RSS feeds
# GitHub Programs        — public GitHub API, no auth
